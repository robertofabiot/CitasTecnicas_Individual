<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="ni.edu.uam.practicahilos.ProcesadorController"
      alignment="CENTER"
      spacing="16"
      prefWidth="560"
      prefHeight="480">

    <padding>
        <Insets top="20" right="25"
                bottom="20" left="25"/>
    </padding>

    <Label text="Monitor de Procesos Concurrentes"
           style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
    <Label text="NicaData Solutions S.A. — Unidad III: Concurrencia"/>

    <Separator/>

    <!-- Proceso 1: Clientes (100 registros) -->
    <VBox alignment="CENTER" spacing="8" style="-fx-border-color: #cccccc; -fx-border-radius: 6; -fx-padding: 12;">
        <Label text="Procesamiento de Clientes (100 registros)" style="-fx-font-weight: bold;"/>
        <Label fx:id="lblEstado"
               text="Esperando inicio"/>

        <ProgressBar fx:id="barraProgreso"
                     progress="0"
                     prefWidth="420"/>

        <Label fx:id="lblPorcentaje"
               text="0%"/>

        <HBox alignment="CENTER" spacing="10">
            <Button fx:id="btnIniciar"
                    text="Iniciar"
                    onAction="#iniciarProceso"/>

            <Button fx:id="btnDetener"
                    text="Detener"
                    onAction="#detenerProceso"
                    disable="true"/>

            <Button fx:id="btnReiniciar"
                    text="Reiniciar"
                    onAction="#reiniciarProceso"/>
        </HBox>
    </VBox>

    <!-- Proceso 2: Reto Final - Productos (50 registros) -->
    <VBox alignment="CENTER" spacing="8" style="-fx-border-color: #cccccc; -fx-border-radius: 6; -fx-padding: 12;">
        <Label text="Reto final: Procesamiento de Productos (50 registros)" style="-fx-font-weight: bold;"/>
        <Label fx:id="lblEstadoProductos"
               text="Esperando inicio"/>

        <ProgressBar fx:id="barraProgresoProductos"
                     progress="0"
                     prefWidth="420"/>

        <Label fx:id="lblPorcentajeProductos"
               text="0%"/>

        <HBox alignment="CENTER" spacing="10">
            <Button fx:id="btnIniciarProductos"
                    text="Iniciar"
                    onAction="#iniciarProductos"/>

            <Button fx:id="btnDetenerProductos"
                    text="Detener"
                    onAction="#detenerProductos"
                    disable="true"/>

            <Button fx:id="btnReiniciarProductos"
                    text="Reiniciar"
                    onAction="#reiniciarProductos"/>
        </HBox>
    </VBox>
</VBox>

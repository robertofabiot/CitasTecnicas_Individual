<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:id="root" fx:controller="com.example.evaluacion_javafx_citastecnicas.CitasController">
 <top><VBox><ToolBar><Label text="TecnoAsistencia"><font><Font name="System Bold" size="16"/></font></Label><Region HBox.hgrow="ALWAYS"/><Button text="Inicio" onAction="#irInicio" disable="false" minWidth="100"/><Button text="Clientes" onAction="#irClientes" disable="false" minWidth="100"/><Button text="Citas" onAction="#irCitas" disable="true" minWidth="100"/></ToolBar></VBox></top>
 <center><VBox>
  <fx:include fx:id="citaForm" source="cita-form.fxml"/>
  <Separator/>
  <VBox spacing="10" VBox.vgrow="ALWAYS"><padding><Insets top="16" right="24" bottom="18" left="24"/></padding>
   <Label text="Citas registradas"><font><Font name="System Bold" size="18"/></font></Label>
   <HBox spacing="10" alignment="CENTER_LEFT"><Label text="Estado" labelFor="$filtroEstado"/><ComboBox fx:id="filtroEstado" prefWidth="150"/><Label text="Fecha" labelFor="$filtroFecha"/><DatePicker fx:id="filtroFecha" prefWidth="170"/><Button fx:id="filtrar" text="Filtrar" onAction="#filtrar"/><Button text="Limpiar filtros" onAction="#limpiarFiltros"/></HBox>
   <TableView fx:id="tabla" VBox.vgrow="ALWAYS" minHeight="150" prefHeight="240">
    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
    <placeholder><Label text="No hay citas para mostrar."/></placeholder><columns><TableColumn fx:id="idCol" text="ID" prefWidth="55"/><TableColumn fx:id="clienteCol" text="Cliente" prefWidth="250"/><TableColumn fx:id="fechaCol" text="Fecha" prefWidth="110"/><TableColumn fx:id="horaCol" text="Hora" prefWidth="75"/><TableColumn fx:id="servicioCol" text="Servicio" prefWidth="265"/><TableColumn fx:id="estadoCol" text="Estado" prefWidth="125"/></columns>
   </TableView>
   <HBox alignment="CENTER_LEFT" spacing="10"><Label fx:id="resumen" text="Cargando registros…"/><Region HBox.hgrow="ALWAYS"/><Button fx:id="verDetalles" text="Ver detalles"/><Button fx:id="editar" text="Editar seleccionado"/></HBox>
   <Label text="Un clic: seleccionar · Doble clic: detalles · Clic derecho: editar o eliminar"/>
  </VBox>
 </VBox></center>
</BorderPane>
<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:id="root" fx:controller="com.example.evaluacion_javafx_citastecnicas.MenuController">
 <top><VBox><ToolBar><Label text="TecnoAsistencia"><font><Font name="System Bold" size="16"/></font></Label><Region HBox.hgrow="ALWAYS"/><Button text="Inicio" onAction="#irInicio" disable="true" minWidth="100"/><Button text="Clientes" onAction="#irClientes" disable="false" minWidth="100"/><Button text="Citas" onAction="#irCitas" disable="false" minWidth="100"/><Button text="Procesos" onAction="#irProcesos" disable="false" minWidth="100"/></ToolBar></VBox></top>
 <center><VBox alignment="CENTER" spacing="22"><padding><Insets top="36" right="40" bottom="36" left="40"/></padding>
  <Label text="Gestión de atención técnica"><font><Font name="System Bold" size="30"/></font></Label>
  <Label text="Clientes, citas y concurrencia en un solo lugar."/>
  <Separator maxWidth="850"/>
  <HBox alignment="CENTER" spacing="20">
   <VBox alignment="CENTER" spacing="16" prefWidth="270"><padding><Insets top="24" right="16" bottom="24" left="16"/></padding>
    <Label text="Clientes"><font><Font name="System Bold" size="22"/></font></Label><Label text="Registre clientes, consulte sus datos y mantenga actualizada su información." wrapText="true" textAlignment="CENTER"/>
    <Button text="Gestionar clientes" onAction="#irClientes" minWidth="200" prefHeight="40"/>
   </VBox>
   <Separator orientation="VERTICAL"/>
   <VBox alignment="CENTER" spacing="16" prefWidth="270"><padding><Insets top="24" right="16" bottom="24" left="16"/></padding>
    <Label text="Citas técnicas"><font><Font name="System Bold" size="22"/></font></Label><Label text="Agende servicios, consulte citas y dé seguimiento a cada atención." wrapText="true" textAlignment="CENTER"/>
    <Button text="Gestionar citas" onAction="#irCitas" minWidth="200" prefHeight="40"/>
   </VBox>
   <Separator orientation="VERTICAL"/>
   <VBox alignment="CENTER" spacing="16" prefWidth="270"><padding><Insets top="24" right="16" bottom="24" left="16"/></padding>
    <Label text="Procesos con hilos"><font><Font name="System Bold" size="22"/></font></Label><Label text="Supervise tareas en segundo plano con Thread, Runnable y Platform.runLater()." wrapText="true" textAlignment="CENTER"/>
    <Button text="Monitor de hilos" onAction="#irProcesos" minWidth="200" prefHeight="40"/>
   </VBox>
  </HBox>
  <Separator maxWidth="850"/>
  <Label text="Comience registrando un cliente, programe su cita o supervise tareas concurrentes."/>
  </VBox></center>
 <bottom><Label text="TecnoAsistencia Nicaragua S.A."><padding><Insets top="16" right="24" bottom="16" left="24"/></padding></Label></bottom>
</BorderPane>
